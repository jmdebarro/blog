---
layout: base.njk
---
<style>
  .post { max-width: 720px; margin: 0 auto; padding: 72px var(--gutter) 120px; width: 100%; }
  .post-head { display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px; }
  .post-head h1 { margin: 0; font-family: var(--display); font-weight: 600; font-size: clamp(48px, 7vw, 80px); line-height: 0.98; text-wrap: balance; }
  .post-head .dek { margin: 0; font-size: 22px; font-style: italic; line-height: 1.5; color: var(--text-soft); }
  .post figure { margin: 0 0 48px; display: flex; flex-direction: column; gap: 10px; }
  .post figure img { height: 440px; }
  .post figcaption { font-family: var(--mono); font-size: 12px; color: var(--muted); }

  .prose { font-size: 20px; line-height: 1.7; }
  .prose > * + * { margin-top: 1.1em; }
  .prose p { margin: 1.1em 0 0; }
  .prose > :first-child { margin-top: 0; }
  .prose h1, .prose h2 { margin: 1.6em 0 0; font-family: var(--display); font-weight: 600; font-size: 40px; line-height: 1.1; }
  .prose h3 { margin: 1.6em 0 0; font-family: var(--mono); font-weight: 500; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose code { font-family: var(--mono); font-size: 0.8em; background: #1A1714; padding: 2px 6px; border-radius: 4px; }
  .prose pre { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 20px 24px; overflow-x: auto; font-size: 14px; line-height: 1.7; }
  .prose pre code { background: none; padding: 0; font-size: inherit; }
  .prose ol { list-style: none; padding: 0; margin: 1.4em 0 0; counter-reset: step; border-top: 1px solid var(--line); }
  .prose ol li { counter-increment: step; display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--line); font-size: 19px; line-height: 1.65; }
  .prose ol li::before { content: counter(step, decimal-leading-zero); font-family: var(--mono); font-size: 14px; color: var(--accent); padding-top: 4px; }
  .prose ol li > p { margin: 0; }
  .prose h1 + p, .prose h2 + p, .prose h3 + p { margin-top: 0.5em; }
  .prose ul { padding-left: 1.2em; }
  .prose blockquote { margin-left: 0; border: 1px solid var(--line); background: var(--surface); border-radius: 8px; padding: 20px 24px; color: var(--text-soft); font-size: 18px; }
  .prose img { border-radius: 8px; }

  .post-nav { margin-top: 64px; border-top: 1px solid var(--line); padding-top: 24px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; font-family: var(--mono); font-size: 13px; letter-spacing: 0.06em; }
  .post-nav a { padding: 12px 0; color: var(--accent); }
  @media (max-width: 600px) { .post figure img { height: 260px; } }
</style>

<article class="post">
  <div class="post-head">
    <span class="label">{{ page.date | readableDate }}{% if topics %} · {{ topics }}{% endif %}</span>
    <h1>{{ title }}</h1>
    {% if description %}<p class="dek">{{ description }}</p>{% endif %}
  </div>

  {% if image %}
  <figure>
    <div class="framed"><img src="{{ image }}" alt="{{ imageAlt or title }}"></div>
    {% if imageCaption %}<figcaption>{{ imageCaption }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  <nav class="post-nav" aria-label="Post navigation">
    <a href="/#writing">← All writing</a>
    <a href="https://github.com/jmdebarro" target="_blank" rel="noopener">GitHub ↗</a>
  </nav>
</article>
